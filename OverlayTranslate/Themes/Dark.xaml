<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#1E1E1E</Color>
    <Color x:Key="PanelBackgroundColor">#2D2D2D</Color>
    <Color x:Key="BorderBaseColor">#404040</Color>
    <Color x:Key="TextBaseColor">#E0E0E0</Color>
    <Color x:Key="AccentColor">#4CC2FF</Color>
    <Color x:Key="ButtonFaceColor">#3C3C3C</Color>
    <Color x:Key="ButtonHoverColor">#505050</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBaseBrush" Color="{DynamicResource BorderBaseColor}" />
    <SolidColorBrush x:Key="TextBaseBrush" Color="{DynamicResource TextBaseColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="ButtonFaceBrush" Color="{DynamicResource ButtonFaceColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}" />
</ResourceDictionary>
