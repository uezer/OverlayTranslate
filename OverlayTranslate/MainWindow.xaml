<Window x:Class="OverlayTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="当前语言" />
        <ComboBox x:Name="SourceLanguageComboBox"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="目标语言" />
        <ComboBox x:Name="TargetLanguageComboBox"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="OCR 策略" />
        <ComboBox x:Name="OcrStrategyComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="翻译策略" />
        <ComboBox x:Name="TranslationStrategyComboBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Top"
                   Text="在线端点" />
        <TextBox x:Name="OnlineEndpointTextBox"
                 Grid.Row="4"
                 Grid.Column="1"
                 Margin="0,0,0,12"
                 VerticalAlignment="Center" />

        <TextBlock Grid.Row="5"
                   Grid.Column="0"
                   Margin="0,0,12,12"
                   VerticalAlignment="Center"
                   Text="启动行为" />
        <CheckBox x:Name="StartOnLaunchCheckBox"
                  Grid.Row="5"
                  Grid.Column="1"
                  Margin="0,0,0,12"
                  VerticalAlignment="Center"
                  Content="启动后立即进入截图流程" />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="6"
                   Grid.ColumnSpan="2"
                   Foreground="#FF1D4ED8"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="2"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="88"
                    Margin="0,0,8,0"
                    Content="保存"
                    Click="OnSaveClick" />
            <Button Width="88"
                    Content="关闭"
                    Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
