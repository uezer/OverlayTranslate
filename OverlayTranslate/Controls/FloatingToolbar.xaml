<UserControl x:Class="OverlayTranslate.Controls.FloatingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="400">
    <Border Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="6" Padding="8"
            BorderBrush="{DynamicResource BorderBaseBrush}" BorderThickness="1"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnBorderMouseLeftButtonDown"
            MouseMove="OnBorderMouseMove"
            MouseLeftButtonUp="OnBorderMouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
        </Border.Effect>
        <StackPanel>
            <!-- 翻译中进度条 -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,4">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <!-- 第一行：语言选择 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="原语言:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="SourceLanguageComboBox" Width="100" Margin="0,0,8,0" />
                <TextBlock Text="目标语言:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="TargetLanguageComboBox" Width="100" />
            </StackPanel>

            <!-- 第二行：引擎选择 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="OCR引擎:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="OcrEngineComboBox" Width="100" Margin="0,0,8,0" />
                <TextBlock Text="翻译引擎:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox x:Name="TranslationEngineComboBox" Width="100" />
            </StackPanel>

            <!-- 第三行：操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="重选" Margin="0,0,6,0"
                        Command="{Binding ReselectCommand}" Padding="12,4" />
                <Button Content="{Binding ViewModeText}" Margin="0,0,6,0"
                        Command="{Binding ToggleViewModeCommand}" Padding="12,4" />
                <Button Content="{Binding ExpandButtonText}" Margin="0,0,6,0"
                        Command="{Binding ToggleExpandCommand}" Padding="6,4" />
                <Button Content="复制原文" Margin="0,0,6,0"
                        Command="{Binding CopyOriginalCommand}" Padding="12,4" />
                <Button Content="复制译文" Margin="0,0,6,0"
                        Command="{Binding CopyTranslatedCommand}" Padding="12,4" />
                <Button Content="退出" Margin="0,0,0,0"
                        Command="{Binding ExitCommand}" Padding="12,4" />
            </StackPanel>

            <!-- 扩展面板（默认隐藏） -->
            <StackPanel Margin="0,4,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExpandPanelVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Separator Margin="0,0,0,4" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="显示原图" Margin="0,0,6,0"
                            Command="{Binding ShowOriginalImageCommand}" Padding="12,4" />
                    <CheckBox x:Name="OriginalBgFillCheckBox" Content="原文底色覆盖"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"
                              Click="OnOriginalBgFillClick" />
                    <CheckBox x:Name="TranslatedBgFillCheckBox" Content="译文底色覆盖"
                              IsChecked="True" VerticalAlignment="Center"
                              Click="OnTranslatedBgFillClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
